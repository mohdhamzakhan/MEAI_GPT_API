{
  "AllowedHosts": "*",
  "AccessControl": {
    "_comment": "Usernames allowed to submit answer corrections (POST /api/rag/feedback). Add/remove usernames here — no code change or redeploy needed.",
    "CorrectionAllowedUsers": [ "hamza.khan" ]
  },
  "JwtSettings": {
    "_comment": "JWT Settings for the login",
    "SecretKey": "MEAI-SUPER-SECRET-KEY-@2025-STRONG#!",
    "Issuer": "FORMAPPLICATIONMEAI",
    "Audience": "MEAI",
    "ExpiryInHours": 8
  },
  "ADSettings": {
    "_comment": "Domain name and it will judge the user he is from Sanand or Manesar",
    "Domain": "MEAI001N.com"
  },
  "OpenTelemetry": {
    "Metrics": {
      "ExporterEndpoint": "http://localhost:9090/metrics"
    }
  },
  "ConnectionStrings": {
    "Redis": "10.235.20.58:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MEAI_GPT_API.Services.DynamicRagService": "Information",
      "MEAI_GPT_API.Services.ModelManager": "Information",
      "MEAI_GPT_API.Services.DynamicCollectionManager": "Information"
    }
  },
  "ChromaDB": {
    "BaseUrl": "http://10.235.20.91:7654",
    "TimeoutMinutes": 5,
    "Tenant": "default_tenant",
    "Database": "default_database",
    "PolicyFolder": "./policies",
    "ContextFolder": "./context",
    "SupportedExtensions": [ ".txt", ".pdf", ".docx", ".md", ".doc" ],
    "Collections": {
      "policies": "meai_policies"
    }
  },
  "AnnexureLinks": {
    "_comment": "Disabled by default. Set Enabled=true and BaseServerPath once the annexure file share is confirmed reachable from this app server. Folder convention: {BaseServerPath}\\{exact source document filename, no extension}\\Annexure {N}.<any allowed extension>",
    "Enabled": false,
    "BaseServerPath": "\\\\SERVERNAME\\policies",
    "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".xls", ".xlsx" ],
    "CacheMinutes": 10
  },
  "Ollama": {
    "BaseUrl": "http://10.235.20.91:11434",
    "TimeoutMinutes": 10
  },
  "OllamaLoadBalancer": {
    "Endpoints": [
      "http://10.235.20.91:11434"

    ],
    "HealthCheckIntervalSeconds": 30,
    "TimeoutMinutes": 10
  },
  "Plant": {
    "Sanand": "Sanand",
    "Manesar": "Manesar",
    "Centralized": "Centralized"
  },
  "PolicyTriggers": {
    "FilePath": "./context/policy-triggers.json"
  },
  "RerankerService": {
    "_comment": "Dedicated cross-encoder reranking microservice (replaces the old qllama/bge-reranker-v2-m3-via-Ollama approach, which 500'd because that model's quantization has no usable logits head via /api/generate). Confirmed working: POST {BaseUrl}/rerank with {query, documents:[...]} returns {results:[{index, score, document}]} sorted by score.",
    "BaseUrl": "http://10.235.20.91:8001",
    "Enabled": true,
    "TimeoutSeconds": 15
  },
  "DocumentRouter": {
    "_comment": "Scalable replacement for hand-writing TopicAnchorService trigger-phrase entries per document (doesn't scale to 130+ policies). Fetches the live document list and asks one fast model call per query which 1-2 documents are likely relevant, then anchors retrieval toward those. Fails open (no effect, not an error) if disabled or if the model call fails.",
    "Enabled": true,
    "Model": "mistral:latest",
    "MaxDocumentsInPrompt": 200
  },
  "LearnedTriggers": {
    "FilePath": "Data/learned-triggers.json"
  },
  "DynamicRAG": {
    "DefaultGenerationModel": "llama3.1:8b",
    "GroundingRetryModel": "qwen3.5:27b",
    "VerifierModel": "qwen3.5:9b",
    "TriggerGenerationDelayMs": 2000,
    "DefaultEmbeddingModel": "nomic-embed-text:v1.5",
    "DefaultCodingModel": "codestral:latest",
    "CacheExpirationMinutes": 60,
    "MaxConcurrentQueries": 10,
    "AutoDiscoverModels": true,
    "ModelDiscoveryTimeoutMs": 30000,
    "PolicyFolder": "./policies",
    "ContextFolder": "./context",
    "SupportedExtensions": [ ".txt", ".pdf", ".docx", ".md" ],
    "AdditionalDocumentSources": [
      {
        "_comment": "Any folder added under policies/{Folder} here gets indexed automatically. RestrictedToPlants empty = visible to every plant, like Centralized. Non-empty = only visible for the listed plants.",
        "Folder": "Technical",
        "RestrictedToPlants": []
      },
      {
        "Folder": "Customers",
        "RestrictedToPlants": []
      }
    ],
    "ReferenceTypes": [
      {
        "_comment": "Numbered references extracted at index time and matched exactly at query time (same treatment originally built for Annexure). Pattern must have exactly one capture group for the number. Add a new entry here for any new reference style (e.g. Exhibit, Schedule) without touching code.",
        "Name": "Annexure",
        "Pattern": "annex(?:ure)?\\s*(?:no\\.?)?\\s*(\\d+)",
        "MetadataKey": "annexure_refs"
      },
      {
        "Name": "Clause",
        "Pattern": "clause\\s*(\\d+(?:\\.\\d+)*)",
        "MetadataKey": "clause_refs"
      },
      {
        "_comment": "Covers explicitly NUMBERED forms only (e.g. 'Form 8', 'Form No. 12'). Unnumbered named forms like 'No Dues Form' don't fit this pattern's single-number-capture-group design -- those are handled separately by a dedicated heading pattern in TextChunkingService.cs's SectionPatterns, not here.",
        "Name": "Form",
        "Pattern": "form\\s*(?:no\\.?)?\\s*(\\d+)",
        "MetadataKey": "form_refs"
      }
    ],
    "PreferredModels": {
      "Embedding": [
        "nomic-embed-text:v1.5"
      ],
      "Generation": [
        "llama3.2:1b",
        "llama3.1:8b",
        "mistral:latest",
        "qwen3:8b"
      ]
    },
    "ModelConfigurations": {
      "nomic-embed-text_latest": {
        "Name": "nomic-embed-text:latest",
        "Type": "embedding",
        "MaxContextLength": 8192,
        "Temperature": 0.0,
        "EmbeddingDimension": 768,
        "ModelOptions": {
          "num_ctx": 8192
        }
      },
      "nomic-embed-text_v1.5": {
        "Name": "nomic-embed-text:v1.5",
        "Type": "embedding",
        "MaxContextLength": 8192,
        "Temperature": 0.0,
        "EmbeddingDimension": 768,
        "ModelOptions": {
          "num_ctx": 8192
        }
      },

      "qwen3-embedding_8b": {
        "Name": "qwen3-embedding:8b",
        "Type": "embedding",
        "MaxContextLength": 8192,
        "Temperature": 0.0,
        "EmbeddingDimension": 4096,
        "ModelOptions": {
          "num_ctx": 8192
        }
      },

      "qllama/bge-reranker-v2-m3_f16": {
        "Name": "qllama/bge-reranker-v2-m3:f16",
        "Type": "reranker",
        "MaxContextLength": 568,
        "Temperature": 0.0,
        "ModelOptions": {
          "num_ctx": 568
        }
      },

      "llama3.2_1b": {
        "Name": "llama3.2:1b",
        "Type": "generation",
        "MaxContextLength": 4096,
        "Temperature": 0.2,
        "ModelOptions": {
          "num_ctx": 4096,
          "temperature": 0.2,
          "top_p": 0.95,
          "repeat_penalty": 1.1
        }
      },

      "mistral_latest": {
        "Name": "mistral:latest",
        "Type": "generation",
        "MaxContextLength": 8192,
        "Temperature": 0.1,
        "ModelOptions": {
          "num_ctx": 8192,
          "temperature": 0.1,
          "top_p": 0.9
        }
      },

      "llama3.1_8b": {
        "Name": "llama3.1:8b",
        "Type": "generation",
        "MaxContextLength": 8192,
        "Temperature": 0.1,
        "ModelOptions": {
          "num_ctx": 8192,
          "temperature": 0.1,
          "top_p": 0.9
        }
      },

      "qwen3_8b": {
