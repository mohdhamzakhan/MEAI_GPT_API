          "num_ctx": 32768,
          "temperature": 1,
          "top_p": 0.95,
          "top_k": 20,
          "presence_penalty": 1.5
        }
      },

      "codestral_latest": {
        "Name": "codestral:latest",
        "Type": "generation",
        "MaxContextLength": 32768,
        "Temperature": 0.2,
        "ModelOptions": {
          "num_ctx": 32768,
          "temperature": 0.2,
